THE_ODDS_API_KEY=
ODDS_API_IO_KEY=
ODDS_API_IO_SPORT=football
ODDS_API_IO_LEAGUE=italy-serie-a
ODDS_API_IO_BOOKMAKERS=Bet365,Sisal IT
ODDS_API_IO_EVENT_LIMIT=10

SPORTAGE_PROVIDER_WORKERS=4
SPORTAGE_SCHEDULER_CONFIG=config/provider_scheduler.example.json

# Betfair official Exchange API-NG / Accounts API.
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=

# BetFlag official Exchange API 2.0.7.
BETFLAG_API_KEY=
BETFLAG_API_KEY_NAME=
BETFLAG_API_KEY_LOCATION=header
BETFLAG_USERNAME=
BETFLAG_PASSWORD=
BETFLAG_SESSION_TOKEN=
# Staging is suitable for connector tests only. Set production before any real-money live plan.
BETFLAG_ENVIRONMENT=staging
BETFLAG_BASE_URL=
BETFLAG_TIMEZONE=Europe/Rome

SPORTAGE_EXECUTION_POLICY=config/execution_policy.example.json
SPORTAGE_EXECUTION_VENUE_COOLDOWN_SECONDS=60
SPORTAGE_REQUIRE_LIVE_CERTIFICATION=true
# Refresh official account funds immediately before every automatic live order.
SPORTAGE_REQUIRE_ACCOUNT_FUNDS=true
# Extra free balance required on the independent rescue venue during prepare --live.
SPORTAGE_RESCUE_BALANCE_BUFFER_PCT=0.10

# Hard kill-switch. Keep false during development/shadow/backtest.
SPORTAGE_LIVE_EXECUTION=false

ARB_MIN_NET_ROI=0.015
ARB_BANKROLL=1000
ARB_DB_PATH=data/arbitrage.sqlite3
ARB_COST_CONFIG=config/costs.example.json
ARB_LIQUIDITY_CONFIG=config/liquidity.example.json
