THE_ODDS_API_KEY=
ODDS_API_IO_KEY=
ODDS_API_IO_SPORT=football
ODDS_API_IO_LEAGUE=italy-serie-a
ODDS_API_IO_BOOKMAKERS=Bet365,Sisal IT
ODDS_API_IO_EVENT_LIMIT=10

# Parallel fetches used by the non-adaptive unified provider.
SPORTAGE_PROVIDER_WORKERS=4

# Adaptive provider scheduler. The outer loop may tick frequently while each
# upstream obeys its own cadence and budget from this JSON file.
SPORTAGE_SCHEDULER_CONFIG=config/provider_scheduler.example.json

# Betfair official Exchange API-NG. The live key must be activated by Betfair.
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=

# BetFlag official Exchange API 2.0.7.
# The public OpenAPI names its authorization scheme `api_key` but does not expose
# the concrete key parameter name in rendered docs, so the name/location are configurable.
BETFLAG_API_KEY=
BETFLAG_API_KEY_NAME=
BETFLAG_API_KEY_LOCATION=header
BETFLAG_USERNAME=
BETFLAG_PASSWORD=
BETFLAG_SESSION_TOKEN=
BETFLAG_ENVIRONMENT=staging
# Optional override, otherwise staging/production official bases are selected automatically.
BETFLAG_BASE_URL=
BETFLAG_TIMEZONE=Europe/Rome

# Fail-closed execution / rescue thresholds.
SPORTAGE_EXECUTION_POLICY=config/execution_policy.example.json

# Hard kill-switch. Keep false during development/shadow/backtest.
# Live orders also require `sportage-exec ... --live` on the specific resume command.
SPORTAGE_LIVE_EXECUTION=false

ARB_MIN_NET_ROI=0.015
ARB_BANKROLL=1000
ARB_DB_PATH=data/arbitrage.sqlite3
ARB_COST_CONFIG=config/costs.example.json
ARB_LIQUIDITY_CONFIG=config/liquidity.example.json
