# Aggregated market discovery. These feeds broaden bookmaker visibility but do NOT
# count as direct personal-account execution connections.
ODDS_API_IO_KEY=
ODDS_API_IO_SPORT=football
ODDS_API_IO_LEAGUE=italy-serie-a
ODDS_API_IO_BOOKMAKERS=Bet365,Betfair IT,BetFlag IT,Bwin IT,Eurobet IT,Goldbet IT,Lottomatica IT,Planetwin365 IT,Sisal IT,Snai IT
ODDS_API_IO_EVENT_LIMIT=10

# Low-frequency independent aggregator used for redundancy/cross-checks.
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_MARKETS=h2h,spreads,totals

SPORTAGE_PROVIDER_WORKERS=2
SPORTAGE_SCHEDULER_CONFIG=config/provider_scheduler.acepc.json
SPORTAGE_MIN_OPERATOR_COVERAGE=10
SPORTAGE_TARGET_OPERATORS=bet365,betfair,betflag,bwin,eurobet,goldbet,lottomatica,planetwin365,sisal,snai

# Direct execution universe on an Italian ACEPC. This is deliberately distinct
# from aggregator coverage. As of the 2026-09-10 official-API/legal audit, only
# Betfair Italia and BetFlag are verified ADM-eligible personal-account APIs with
# programmatic order capability. The direct venue monitor records all researched
# alternatives but will not connect to venues blocked/not authorised for Italy.
SPORTAGE_DIRECT_TARGET_OPERATORS=betfair,betflag
SPORTAGE_DIRECT_VENUE_CHECK_MINUTES=15

# Betfair Italia Exchange API-NG. Certificate login obtains a fresh session token
# in process memory; no long-lived session token needs to be persisted.
BETFAIR_JURISDICTION=IT
BETFAIR_CERT_LOGIN_URL=
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_FILE=/home/stoicpawn/.config/sportage/betfair/client-2048.crt
BETFAIR_KEY_FILE=/home/stoicpawn/.config/sportage/betfair/client-2048.key

# BetFlag official Exchange API 2.0.7. Leave staging until production API access
# has been issued and the venue has passed Sportage certification.
BETFLAG_API_KEY=
BETFLAG_API_KEY_NAME=
BETFLAG_API_KEY_LOCATION=header
BETFLAG_USERNAME=
BETFLAG_PASSWORD=
BETFLAG_SESSION_TOKEN=
BETFLAG_ENVIRONMENT=staging
BETFLAG_BASE_URL=
BETFLAG_TIMEZONE=Europe/Rome

SPORTAGE_EXECUTION_POLICY=config/execution_policy.example.json
SPORTAGE_EXECUTION_VENUE_COOLDOWN_SECONDS=60
SPORTAGE_REQUIRE_LIVE_CERTIFICATION=true
SPORTAGE_REQUIRE_ACCOUNT_FUNDS=true
SPORTAGE_RESCUE_BALANCE_BUFFER_PCT=0.10
SPORTAGE_CANARY_MODE=true
SPORTAGE_CANARY_POLICY=config/canary_policy.example.json
SPORTAGE_REQUIRE_COMMISSIONING=true
SPORTAGE_COMMISSIONING_TTL_MINUTES=30

# Hard safety switch. Monitoring, result collection and venue certification keep
# this false. Real order transmission requires a separate explicit commissioning
# step after credentials, funds and venue certification are green.
SPORTAGE_LIVE_EXECUTION=false

ARB_MIN_NET_ROI=0.015
ARB_BANKROLL=1000
ARB_DB_PATH=data/arbitrage.sqlite3
ARB_COST_CONFIG=config/costs.example.json
ARB_LIQUIDITY_CONFIG=config/liquidity.example.json
