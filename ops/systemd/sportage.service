[Unit]
Description=Sportage read-only control center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/stoicpawn/projects/Sportage
EnvironmentFile=-/home/stoicpawn/projects/Sportage/.env
Environment=PYTHONPATH=/home/stoicpawn/projects/Sportage/src
Environment=SPORTAGE_LIVE_EXECUTION=false
Environment=SPORTAGE_PROVIDER_WORKERS=2
Environment=SPORTAGE_SCHEDULER_CONFIG=config/provider_scheduler.acepc.json
ExecStart=/home/stoicpawn/projects/Sportage/.venv/bin/sportage ui --db data/arbitrage.sqlite3 --host 0.0.0.0 --port 8501
Restart=on-failure
RestartSec=10
Slice=side-projects.slice
CPUWeight=100
Nice=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
