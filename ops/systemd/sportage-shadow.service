[Unit]
Description=Sportage direct-broker read-only arbitrage shadow collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/stoicpawn/projects/Sportage
EnvironmentFile=-/home/stoicpawn/projects/Sportage/.env
Environment=PYTHONPATH=/home/stoicpawn/projects/Sportage/src
Environment=SPORTAGE_LIVE_EXECUTION=false
Environment=SPORTAGE_PROVIDER_WORKERS=2
Environment=SPORTAGE_SCHEDULER_CONFIG=config/provider_scheduler.acepc.json
Environment=ARB_DB_PATH=data/arbitrage.sqlite3
Environment=ARB_MIN_NET_ROI=0.015
ExecStart=/usr/bin/bash /home/stoicpawn/projects/Sportage/ops/run_shadow.sh
Restart=always
RestartSec=30
RuntimeMaxSec=6h
TimeoutStopSec=20
KillSignal=SIGINT
Slice=side-projects.slice
CPUWeight=100
Nice=15
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
